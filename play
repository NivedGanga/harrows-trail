#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
engine="$project_dir/.local/luanti.app/Contents/MacOS/luanti"
if [ ! -x "$engine" ]; then
  printf 'The pinned Luanti installation is missing.\n' >&2
  exit 1
fi
mkdir -p "$project_dir/.local"
if [ "${HARROWS_WORLD+x}" = x ]; then
  world_dir=$HARROWS_WORLD
  if [ -L "$world_dir" ] || [ ! -f "$world_dir/.harrows-play-disposable" ] || [ ! -f "$world_dir/harrows.conf" ]; then
    printf 'Refusing to open an unrecognized Harrow test world: %s\n' "$world_dir" >&2
    exit 1
  fi
else
  world_dir=$(mktemp -d "$project_dir/.local/play-world.XXXXXX")
  touch "$world_dir/.harrows-play-disposable"
  printf 'gameid = mineclonia\nbackend = sqlite3\nplayer_backend = sqlite3\nauth_backend = sqlite3\nmod_storage_backend = sqlite3\nload_mod_harrows_trail = true\n' > "$world_dir/world.mt"
  printf 'fixed_map_seed = 1730940739604968791\nharrows_trail_grounded = true\n' > "$world_dir/harrows.conf"
fi
lock_dir="$world_dir/.harrows-session.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf 'This world is already open or has a stale lock: %s\n' "$lock_dir" >&2
  exit 1
fi
trap 'rmdir "$lock_dir" 2>/dev/null || :' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf 'Harrow test world: %s\n' "$world_dir"
export LUANTI_USER_PATH="$project_dir/.local/user"
export LUANTI_GAME_PATH="$project_dir/.local/games"
export LUANTI_MOD_PATH="$project_dir/mod"
"$engine" --world "$world_dir" --config "$world_dir/harrows.conf" --go --name "${HARROWS_PLAYER:-pen_tester}" --port "${HARROWS_PORT:-30995}"
